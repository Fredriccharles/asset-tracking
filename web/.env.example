# Asset Tracker — Web Version Environment Variables
# Copy this file to `.env` and adjust as needed.

# Port the server listens on (default 8080)
PORT=8080

# Host to bind to. Use 0.0.0.0 to expose on all interfaces
# (needed for LAN / internet access).
HOST=0.0.0.0

# Default admin credentials used ONLY on first run (when no users exist yet).
# Change these before deploying publicly!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: override where the SQLite database + backups are stored.
# Defaults to ./data (inside the web folder).
# APP_DATA_DIR=/var/data/asset-tracker
# DB_PATH=/var/data/asset-tracker/assets.db
# BACKUP_DIR=/var/data/asset-tracker/backups
